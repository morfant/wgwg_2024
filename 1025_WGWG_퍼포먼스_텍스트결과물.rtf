\f0\b \uc0\u45796 \u50577 \u54620  \u47928 \u54868 \u50752  \u49324 \u54924 \u51201  \u51652 \u48372 \u47484  \u44032 \u45733 \u54616 \u44172  \u54616 \u45716  \u44221 \u51228 \u51201  \u44592 \u48152 
\f1\b0 \uc0\u51012  \u51228 \u44277 \u54633 \u45768 \u45796 .\
\uc0\u47932 \u47200 , \u51088 \u48376 \u51452 \u51032 \u45716  \u44060 \u49440 \u51060  \u54596 \u50836 \u54633 \u45768 \u45796 . \u44221 \u51228 \u51201  \u48520 \u54217 \u46321 \u44284  \u54872 \u44221  \u54028 \u44340 \u45716  \u54644 \u44208 \u54644 \u50556  \u54624  \u47928 \u51228 \u51077 \u45768 \u45796 . \u44536 \u47084 \u45208  \u51088 \u48376 \u51452 \u51032 \u47484  \u50756 \u51204 \u55176  \u48260 \u47532 \u45716  \u44163 \u51008  \u44284 \u44144 \u47196 \u51032  \u53748 \u48372 \u47484  \u51032 \u48120 \u54633 \u45768 \u45796 . \u50864 \u47532 \u45716  \u51088 \u48376 \u51452 \u51032 \u51032  \u51109 \u51216 \u51012  \u49332 \u47532 \u47732 \u49436 \u46020  \u44536  \u45800 \u51216 \u51012  \u48372 \u50756 \u54616 \u45716  \u48169 \u54693 \u51004 \u47196  \u45208 \u50500 \u44032 \u50556  \u54633 \u45768 \u45796 . 
