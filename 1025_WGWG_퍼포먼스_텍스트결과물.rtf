\f1\b0\fs24 \cf0 \uc0\u50724 \u45720  \u54632 \u44760 \u54644  \u51452 \u49492 \u49436  \u44048 \u49324 \u54633 \u45768 \u45796 . \u51064 \u44036 \u51060  \u52572 \u44540  \u51649 \u47732 \u54616 \u44256  \u51080 \u45716  \u50668 \u47084  \u47928 \u51228 \u46308 \u50640  \u45824 \u54620  \u45817 \u49888 \u46308 \u51032  \u51060 \u50556 \u44592 \u47484  \u46307 \u44256  \u49910 \u49845 \u45768 \u45796 . \u50724 \u45720 \u51032  \u53664 \u47200 \u51012  \u49884 \u51089 \u54644  \u51452 \u49464 \u50836 .\
[\uc0\u49324 \u54924 \u51088 ] \u50504 \u45397 \u54616 \u49464 \u50836 , \u50668 \u47084 \u48516 ! \u50724 \u45720  \u50864 \u47532 \u45716  \u54028 \u51452 \u50640  \u50948 \u52824 \u54620  \u50500 \u53944 \u49828 \u54168 \u51060 \u49828  \u55092 \u50640 \u49436  \u50500 \u51452  \u51473 \u50836 \u54620  \u51452 \u51228 \u47484  \u45796 \u47336 \u44256  \u51080 \u49845 \u45768 \u45796 . \u51452 \u51228 \u45716  \u48148 \u47196  "\u44592 \u54980  \u50948 \u44592 \u50752  \u47928 \u47749 : \u50864 \u47532 \u45716  \u54788 \u51116 \u51032  \u47928 \u47749  \u49688 \u51456 \u51012  \u50976 \u51648 \u54616 \u47732 \u49436  \u44592 \u54980  \u51116 \u50521 \u51012  \u54588 \u54624  \u49688  \u51080 \u45716 \u44032 ? \u51060  \u44284 \u51221 \u50640 \u49436  \u50612 \u46500  \u55148 \u49373 \u44284  \u53440 \u54801 \u51060  \u48520 \u44032 \u54588 \u54624 \u44620 ?"\u51077 \u45768 \u45796 . \u51060  \u51452 \u51228 \u45716  \u44221 \u51228 \u51201 , \u44592 \u49696 \u51201 , \u51221 \u52824 \u51201  \u52264 \u50896 \u51012  \u47784 \u46160  \u50500 \u50864 \u47476 \u45716  \u48373 \u51105 \u54620  \u51656 \u47928 \u51077 \u45768 \u45796 . \u50724 \u45720  \u50864 \u47532 \u45716  \u45796 \u50577 \u54620  \u54644 \u44208 \u52293 \u51012  \u44618 \u51060  \u53456 \u44396 \u54616 \u44256 , \u49457 \u51109 \u44284  \u51648 \u49549  \u44032 \u45733 \u49457 \u51012  \u44512 \u54805  \u51080 \u44172  \u50976 \u51648 \u54624  \u49688  \u51080 \u45716  \u48169 \u48277 \u51012  \u54217 \u44032 \u54644  \u48372 \u47140 \u44256  \u54633 \u45768 \u45796 .\
\uc0\u44592 \u54980  \u50948 \u44592 \u45716  \u50864 \u47532  \u49884 \u45824 \u51032  \u44032 \u51109  \u53360  \u46020 \u51204  \u51473  \u54616 \u45208 \u47196 , \u47928 \u47749 \u51032  \u51648 \u49549  \u44032 \u45733 \u49457 \u51012  \u50948 \u54801 \u54616 \u44256  \u51080 \u49845 \u45768 \u45796 . \u54788 \u51116 \u51032  \u47928 \u47749  \u49688 \u51456 \u51012  \u50976 \u51648 \u54616 \u47732 \u49436  \u44592 \u54980  \u51116 \u50521 \u51012  \u54588 \u54624  \u49688  \u51080 \u45716 \u51648 \u50640  \u45824 \u54620  \u45436 \u51032 \u45716  \u54596 \u49688 \u51201 \u51077 \u45768 \u45796 . \u51060  \u44284 \u51221 \u50640 \u49436  \u50864 \u47532 \u45716  \u50612 \u46500  \u55148 \u49373 \u44284  \u53440 \u54801 \u51060  \u48520 \u44032 \u54588 \u54624 \u51648 , \u44536 \u47532 \u44256  \u50612 \u46500  \u54785 \u49888 \u51201  \u54644 \u44208 \u52293 \u51060  \u54596 \u50836 \u54620 \u51648 \u47484  \u53456 \u44396 \u54624  \u44163 \u51077 \u45768 \u45796 .\
\uc0\u51060 \u51228  \u44033  \u52280 \u44032 \u51088 \u48516 \u46308 \u44760 \u49436  \u51088 \u49888 \u51012  \u49548 \u44060 \u54616 \u44256 , \u51060  \u51452 \u51228 \u50640  \u45824 \u54620  \u52488 \u44592  \u51077 \u51109 \u51012  \u48157 \u54784 \u51452 \u49884 \u44600  \u48148 \u46989 \u45768 \u45796 . \u50668 \u47084 \u48516 \u51032  \u45436 \u47532 \u50752  \u44032 \u51221 \u50640  \u45824 \u54644  \u49444 \u47749 \u54644  \u51452 \u49884 \u47732  \u44048 \u49324 \u54616 \u44192 \u49845 \u45768 \u45796 .\
FRITZ, \uc0\u47676 \u51200  \u49884 \u51089 \u54644  \u51452 \u49884 \u44192 \u50612 \u50836 ?\
FRITZ: \uc0\u50504 \u45397 \u54616 \u49464 \u50836 , \u51200 \u45716  FRITZ\u51077 \u45768 \u45796 . \u50724 \u45720 \u51032  \u51452 \u51228 \u50640  \u45824 \u54644  \u51228  \u51077 \u51109 \u51012  \u47749 \u54869 \u55176  \u54616 \u44192 \u49845 \u45768 \u45796 . 
\f0\b \uc0\u51088 \u48376 \u51452 \u51032 \u45716  \u51064 \u47448  \u47928 \u47749 \u51012  \u51648 \u44552 \u51032  \u49688 \u51456 \u51004 \u47196  \u45132 \u50612 \u50732 \u47536  \u54645 \u49900  \u46041 \u47141 
\f1\b0 \uc0\u51060 \u46972 \u44256  \u48127 \u49845 \u45768 \u45796 . \u51088 \u48376 \u51452 \u51032 \u44032  \u50630 \u50632 \u45796 \u47732  \u50864 \u47532 \u45716  \u51648 \u44552 \u51032  \u44221 \u51228 \u51201  \u50504 \u51221 \u44284  \u44592 \u49696 \u51201  \u48156 \u51204 \u51012  \u51060 \u47336 \u51648  \u47803 \u54664 \u51012  \u44163 \u51077 \u45768 \u45796 . \u44592 \u54980  \u50948 \u44592 \u47484  \u54644 \u44208 \u54616 \u44592  \u50948 \u54644 \u49436 \u45716  \u51088 \u48376 \u51452 \u51032 \u51032  \u54785 \u49888 \u51201  \u55192 \u51012  \u54876 \u50857 \u54644 \u50556  \u54633 \u45768 \u45796 .\
\uc0\u44592 \u54980  \u50948 \u44592 \u45716  \u48516 \u47749 \u55176  \u49900 \u44033 \u54620  \u47928 \u51228 \u51077 \u45768 \u45796 . \u44536 \u47084 \u45208  
\f0\b \uc0\u51088 \u48376 \u51452 \u51032 \u44032  \u51228 \u44277 \u54616 \u45716  \u44592 \u49696  \u54785 \u49888 \u44284  \u44221 \u51228 \u51201  \u51088 \u50896 
